# =====================================================================
# 00-config.env — configuração central do lab SeaweedFS. Edite aqui
# antes de rodar os scripts.
#
# Topologia (5 VMs Ubuntu + 1 VM roteador, rede isolada):
#   swfs-master1/2/3  -> weed master (quorum Raft real, 3 nós)
#   swfs-vol1          -> weed volume (rack1) + weed filer/S3 embutido
#   swfs-vol2          -> weed volume (rack2)
#   swfs-router        -> Ubuntu (mesma imagem-base das outras), com IP
#                          forwarding + NAT (iptables) já automatizados
#                          via cloud-init — faz a ponte entre a rede
#                          isolada do lab e a internet.
#
# (Tentamos primeiro um roteador FreeBSD via cloud-init — a imagem
# oficial usa "nuageinit", não o cloud-init da Canonical, e nessa versão
# write_files/runcmd/packages não aplicaram de forma confiável. Trocamos
# para Ubuntu para não travar o lab; a imagem FreeBSD fica em Imagens/
# caso você queira retomar esse estudo depois — veja o README.)
# =====================================================================

# Onde os discos/seeds/chaves das VMs ficam salvos
SCRIPT_DIR_HINT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB_DIR="$SCRIPT_DIR_HINT"

# Imagens-base (cloud images), compartilhadas entre as VMs que nascem
# delas via backing file. Ficam separadas em subpasta própria para não
# misturar com os discos/estado de cada VM (veja README > Organização
# de diretórios).
IMAGES_DIR="$LAB_DIR/Imagens"

# --- VMs Ubuntu do cluster SeaweedFS ----------------------------------
VM_NAMES=(swfs-master1 swfs-master2 swfs-master3 swfs-vol1 swfs-vol2)

declare -A VM_ROLE=(
    [swfs-master1]="master (raft)"
    [swfs-master2]="master (raft)"
    [swfs-master3]="master (raft)"
    [swfs-vol1]="volume (rack1) + filer/S3"
    [swfs-vol2]="volume (rack2)"
)

# Recursos por VM (uniforme; ajuste se algum papel precisar de mais)
VM_RAM_MB=2048
VM_VCPUS=2

# Disco de sistema e de dados por VM (conforme pedido: 16G SO + 10G dados)
OS_DISK_SIZE="16G"
DATA_DISK_SIZE="10G"

# Imagem base (Ubuntu Server 24.04 LTS - cloud image oficial)
BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
BASE_IMAGE_NAME="noble-server-cloudimg-amd64.img"
OS_VARIANT="ubuntu24.04"

# --- Instalação do SeaweedFS (feita pelo cloud-init, sem passo manual) ---
# O cloud-init das 5 VMs do cluster já deixa pronto, no primeiro boot:
#   - o binário `weed` baixado e instalado em /usr/local/bin
#   - o disco de dados formatado (ext4), montado em $DATA_MOUNT_DIR e
#     com dono $VM_USER
#   - o(s) serviço(s) systemd do papel de cada VM já habilitados e rodando
#     (weed-master / weed-volume / weed-filer, este último com -s3)
# Ao final do ./deploy-lab.sh o cluster já está de pé e acessível — veja
# README > "Serviços" para os endpoints e ./06-status.sh para conferir.
#
# "latest" sempre baixa a versão mais recente do GitHub Releases; fixe
# uma tag (ex: "3.97") se quiser reprodutibilidade entre deploys.
SEAWEED_VERSION="latest"

# 2º disco virtio de cada VM do cluster (1º = SO) = /dev/vdb dentro dela
DATA_DISK_DEVICE="/dev/vdb"
DATA_MOUNT_DIR="/data"

# --- Serviços do SeaweedFS (systemd, iniciados automaticamente) -------
# Cada VM do cluster já sobe com o(s) serviço(s) do seu papel rodando:
#   swfs-master1/2/3 -> weed-master.service   (quorum Raft, 3 nós)
#   swfs-vol1/vol2    -> weed-volume.service   (1 por rack)
#   $FILER_HOST        -> também weed-filer.service (Filer + API S3)
# Nada disso é mais manual: ./deploy-lab.sh entrega os 4 serviços de pé.
FILER_HOST="swfs-vol1"
ADMIN_HOST="swfs-vol1"   # dashboard web (weed admin) — topologia/volumes/métricas
declare -A VM_RACK=( [swfs-vol1]="rack1" [swfs-vol2]="rack2" )

SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=8080
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_ADMIN_PORT=23646

# Identidade S3 gerada no $FILER_HOST via -s3.config (arquivo JSON escrito
# em ${DATA_MOUNT_DIR}/filer/s3.json pelo cloud-init). Sem isso, o gateway
# S3 só aceita requisições anônimas/não assinadas — qualquer cliente S3 de
# verdade (mc, rclone, boto3, aws-cli, warp) assina, e falha com "Signed
# request requires setting up SeaweedFS S3 authentication". Valores fixos
# (não gerados por VM) de propósito, como VM_PASSWORD acima — lab, não
# produção; troque antes de expor isso fora do seu host.
S3_ACCESS_KEY="swfslab"
S3_SECRET_KEY="71a332182078ebf7f7a1257df152e16b474d1eb2"

# Domínio interno só para /etc/hosts e SSH config
LAB_DOMAIN="swfs-lab.local"

# Usuário criado dentro das VMs Ubuntu
VM_USER="swfs"
VM_PASSWORD="swfs123"   # apenas para lab! troque se quiser

# Chave SSH do HOST usada para você acessar as VMs (gerada se não existir)
SSH_PUBKEY_PATH="$HOME/.ssh/id_rsa.pub"

# Chave SSH exclusiva do CLUSTER — distribuída para as 5 VMs Ubuntu para
# que elas se autentiquem entre si sem senha. Fica salva dentro de
# LAB_DIR, gerada automaticamente se não existir.
CLUSTER_KEY_PATH="$LAB_DIR/cluster_key"

# --- Rede isolada do lab (sem NAT, sem DHCP do libvirt) ---------------
# Só um switch L2 isolado: sem <ip>/<dhcp>. Quem roteia para a internet
# é a VM swfs-router (BSD), com uma perna nesta rede e outra na rede
# "default" do KVM (NAT, já existente). Por isso os IPs abaixo são
# ESTÁTICOS, configurados via cloud-init (netplan) — não tem DHCP aqui.
NET_NAME="seaweedfs-lab"
NET_BRIDGE="virbr-swfs"
NET_PREFIX=24
NET_DNS="1.1.1.1 8.8.8.8"

declare -A VM_IP=(
    [swfs-master1]="192.168.100.11"
    [swfs-master2]="192.168.100.12"
    [swfs-master3]="192.168.100.13"
    [swfs-vol1]="192.168.100.21"
    [swfs-vol2]="192.168.100.22"
)
declare -A VM_MAC=(
    [swfs-master1]="52:54:00:10:00:11"
    [swfs-master2]="52:54:00:10:00:12"
    [swfs-master3]="52:54:00:10:00:13"
    [swfs-vol1]="52:54:00:10:00:21"
    [swfs-vol2]="52:54:00:10:00:22"
)

# --- VM roteador (Ubuntu, mesma imagem-base, NAT automatizado) --------
ROUTER_NAME="swfs-router"
ROUTER_RAM_MB=1024
ROUTER_VCPUS=1
ROUTER_DISK_SIZE="10G"

# Imagem FreeBSD CLOUDINIT — não usada mais pelo roteador (trocamos para
# Ubuntu, veja comentário no topo do arquivo), mas mantida aqui e em
# Imagens/ caso você queira retomar o estudo de BSD depois.
ROUTER_BSD_IMAGE_URL="https://download.freebsd.org/releases/VM-IMAGES/15.1-RELEASE/amd64/Latest/FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz"
ROUTER_BSD_IMAGE_XZ_NAME="FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz"
ROUTER_BSD_IMAGE_NAME="FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2"

# Perna LAN do roteador (na rede isolada seaweedfs-lab) — é o gateway
# do lab. IP fixo, configurado via cloud-init (assim como as demais VMs).
ROUTER_LAN_IP="192.168.100.1"
ROUTER_LAN_MAC="52:54:00:10:00:01"

# Perna WAN do roteador — usa a rede "default" (NAT) que o KVM já cria.
# IP fixo reservado por MAC nessa rede (necessário para você conseguir
# alcançar o roteador — e, através dele, o lab isolado — via SSH a
# partir do host; veja README > Acesso SSH).
ROUTER_WAN_NETWORK="default"
ROUTER_WAN_MAC="52:54:00:10:00:00"
ROUTER_WAN_IP="192.168.122.150"

# Gateway/DNS que as 5 VMs Ubuntu vão usar (aponta para o roteador)
NET_GATEWAY="$ROUTER_LAN_IP"
