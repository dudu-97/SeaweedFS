# =====================================================================
# 00-config.env — configuração central do lab SeaweedFS. Edite aqui
# antes de rodar os scripts.
#
# Topologia (12 VMs Ubuntu + 1 VM roteador, rede isolada) — modelada na
# arquitetura de produção da empresa (LVS + s3front + master/filer +
# pgsql + 7 volume nodes), simplificada para caber em 1 host de lab:
#   swfs-master1/2/3  -> weed master (quorum Raft) + weed filer, cada um.
#                         master1 também roda weed admin + weed worker
#                         (equivalente ao master01 do diagrama da empresa).
#   swfs-s3front1      -> weed s3 standalone (gateway S3 puro, aponta pros
#                         3 filers) — sem LVS na frente (lab de 1 usuário,
#                         não precisa de HA de conexão); acessa direto.
#   swfs-pgsql01       -> PostgreSQL, metadata store dos 3 filers (troca
#                         o LevelDB embutido — é o gargalo de concorrência
#                         citado pela empresa).
#   swfs-node01..07    -> weed volume, 2 processos cada (simula 2 discos
#                         por node) = 14 volume servers no total, alvo
#                         de erasure coding 5+2 (5 dados + 2 paridade =
#                         7 shards, 1 por node — igual à empresa).
#   swfs-router        -> Ubuntu (mesma imagem-base das outras), com IP
#                          forwarding + NAT (iptables) já automatizados
#                          via cloud-init — faz a ponte entre a rede
#                          isolada do lab e a internet.
# =====================================================================

# Força saída em inglês para virsh/qemu-img: os scripts fazem parsing de
# texto da saída desses comandos (ex: procurar a linha "Active: yes" em
# `virsh net-info`). Em host com locale pt_BR (ou outro) essas strings
# saem traduzidas ("Ativa: sim"), o parsing não bate com nada, e os
# scripts concluem o estado errado (ex: tentam iniciar uma rede que já
# está ativa). Isso não muda o idioma de nada que você vê no terminal —
# só da saída interna que os scripts leem.
export LC_ALL=C

# Onde os discos/seeds/chaves das VMs ficam salvos
SCRIPT_DIR_HINT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB_DIR="$SCRIPT_DIR_HINT"

# Imagens-base (cloud images), compartilhadas entre as VMs que nascem
# delas via backing file. Ficam separadas em subpasta própria para não
# misturar com os discos/estado de cada VM (veja README > Organização
# de diretórios).
IMAGES_DIR="$LAB_DIR/Imagens"

# --- VMs Ubuntu do cluster SeaweedFS ----------------------------------
VM_NAMES=(
    swfs-master1 swfs-master2 swfs-master3
    swfs-s3front1
    swfs-pgsql01
    swfs-node01 swfs-node02 swfs-node03 swfs-node04 swfs-node05 swfs-node06 swfs-node07
)

declare -A VM_ROLE=(
    [swfs-master1]="master (raft) + filer + admin + worker"
    [swfs-master2]="master (raft) + filer"
    [swfs-master3]="master (raft) + filer"
    [swfs-s3front1]="S3 gateway standalone"
    [swfs-pgsql01]="PostgreSQL (metadata dos filers)"
    [swfs-node01]="volume x2 (rack1)"
    [swfs-node02]="volume x2 (rack2)"
    [swfs-node03]="volume x2 (rack3)"
    [swfs-node04]="volume x2 (rack4)"
    [swfs-node05]="volume x2 (rack5)"
    [swfs-node06]="volume x2 (rack6)"
    [swfs-node07]="volume x2 (rack7)"
)

# Recursos por VM — heterogêneo por papel (era um valor único pra todas
# as VMs; com 12 VMs de tamanhos bem diferentes isso deixou de fazer
# sentido). Disco de dados vazio ("") = a VM não tem 2º disco.
declare -A VM_RAM_MB=(
    [swfs-master1]=1536 [swfs-master2]=1536 [swfs-master3]=1536
    [swfs-s3front1]=1024
    [swfs-pgsql01]=1536
    [swfs-node01]=1536 [swfs-node02]=1536 [swfs-node03]=1536 [swfs-node04]=1536
    [swfs-node05]=1536 [swfs-node06]=1536 [swfs-node07]=1536
)
declare -A VM_VCPUS=(
    [swfs-master1]=1 [swfs-master2]=1 [swfs-master3]=1
    [swfs-s3front1]=1
    [swfs-pgsql01]=1
    [swfs-node01]=1 [swfs-node02]=1 [swfs-node03]=1 [swfs-node04]=1
    [swfs-node05]=1 [swfs-node06]=1 [swfs-node07]=1
)
declare -A VM_OS_DISK_SIZE=(
    [swfs-master1]="12G" [swfs-master2]="12G" [swfs-master3]="12G"
    [swfs-s3front1]="10G"
    [swfs-pgsql01]="20G"
    [swfs-node01]="10G" [swfs-node02]="10G" [swfs-node03]="10G" [swfs-node04]="10G"
    [swfs-node05]="10G" [swfs-node06]="10G" [swfs-node07]="10G"
)
# Só os volume nodes têm 2º disco — é onde os dados do bucket realmente
# ficam. 70G x 7 nodes = 490G brutos; com EC 5+2 (eficiência 5/7) dá
# ~350G úteis, folgado acima do piso de 200G pedido.
declare -A VM_DATA_DISK_SIZE=(
    [swfs-node01]="70G" [swfs-node02]="70G" [swfs-node03]="70G" [swfs-node04]="70G"
    [swfs-node05]="70G" [swfs-node06]="70G" [swfs-node07]="70G"
)

# Imagem base (Ubuntu Server 24.04 LTS - cloud image oficial)
BASE_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
BASE_IMAGE_NAME="noble-server-cloudimg-amd64.img"

# --- Instalação do SeaweedFS (feita pelo cloud-init, sem passo manual) ---
# "latest" sempre baixa a versão mais recente do GitHub Releases; fixe
# uma tag (ex: "4.45.1") se quiser reprodutibilidade entre deploys.
#
# Edição Enterprise (mesmo binário `weed`, licença trial automática
# abaixo de 25TB — não precisa de arquivo de licença pra este lab):
# repo separado seaweedfs/artifactory, asset "*_large_disk.tar.gz".
SEAWEED_VERSION="latest"
SEAWEED_ENTERPRISE_REPO="seaweedfs/artifactory"
SEAWEED_ENTERPRISE_ASSET="weed-enterprise-linux_amd64_large_disk.tar.gz"

# 2º disco virtio de cada VM (1º = SO) = /dev/vdb dentro dela. Só as VMs
# com VM_DATA_DISK_SIZE preenchido (os volume nodes) usam isso.
DATA_DISK_DEVICE="/dev/vdb"
DATA_MOUNT_DIR="/data"

# --- Papéis do SeaweedFS (systemd, iniciados automaticamente) ---------
MASTER_HOSTS=(swfs-master1 swfs-master2 swfs-master3)   # raft + filer, cada um
ADMIN_HOST="swfs-master1"    # dashboard web (weed admin) — inclui Recovery na Enterprise
WORKER_HOST="swfs-master1"   # weed worker — tarefas de manutenção (EC encode, vacuum, balance)
S3FRONT_HOSTS=(swfs-s3front1)   # weed s3 standalone, aponta pros 3 filers
PGSQL_HOST="swfs-pgsql01"       # metadata store dos filers (troca o LevelDB local)
VOLUME_NODES=(swfs-node01 swfs-node02 swfs-node03 swfs-node04 swfs-node05 swfs-node06 swfs-node07)
VOLUME_PROCS_PER_NODE=2   # processos `weed volume` por node = "discos" simulados

declare -A VM_RACK=(
    [swfs-node01]="rack1" [swfs-node02]="rack2" [swfs-node03]="rack3" [swfs-node04]="rack4"
    [swfs-node05]="rack5" [swfs-node06]="rack6" [swfs-node07]="rack7"
)

SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_BASE_PORT=8080   # node0X usa 8080, 8081, ... (um por processo, VOLUME_PROCS_PER_NODE)
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_S3_METRICS_PORT=9327   # Prometheus /metrics do weed s3 -- SeaweedFS_s3_bucket_{size,physical_size,quota}_bytes, bucket_read_only
SEAWEED_ADMIN_PORT=23646
SEAWEED_UPLOAD_DEMO_PORT=8090
UPLOAD_DEMO_HOST="swfs-s3front1"   # página estática de upload S3 — só pra teste/demo

# PostgreSQL (metadata dos 3 filers, em vez do LevelDB embutido)
PGSQL_PORT=5432
PGSQL_DB="seaweedfs_filer"
PGSQL_USER="seaweedfs"
PGSQL_PASSWORD="swfslab-pg"   # lab, não produção — troque se for expor isso

# Replicação padrão dos volumes: "000" (nenhuma cópia extra) de propósito
# — o objetivo deste ambiente é testar erasure coding 5+2, não replicação.
# Volume nasce normal ("quente") e vira EC quando processado (manual via
# `weed shell` -> ec.encode, ou automático pelo weed worker).
MASTER_DEFAULT_REPLICATION="000"

# Identidade S3 gerada no primeiro filer via -s3.config (arquivo JSON
# escrito em ${DATA_MOUNT_DIR}/filer/s3.json pelo cloud-init, replicado
# pros outros filers). Sem isso, o gateway S3 só aceita requisições
# anônimas/não assinadas — qualquer cliente S3 de verdade (mc, rclone,
# boto3, aws-cli, warp) assina, e falha com "Signed request requires
# setting up SeaweedFS S3 authentication".
S3_ACCESS_KEY="swfslab"
S3_SECRET_KEY="71a332182078ebf7f7a1257df152e16b474d1eb2"

# Domínio interno só para /etc/hosts e SSH config
LAB_DOMAIN="swfs-lab.local"

# Usuário criado dentro das VMs Ubuntu
VM_USER="swfs"
VM_PASSWORD="swfs123"   # apenas para lab! troque se quiser

# Chave SSH do HOST usada para você acessar as VMs (gerada se não existir)
SSH_PUBKEY_PATH="$HOME/.ssh/id_rsa.pub"

# Chave SSH exclusiva do CLUSTER — distribuída para todas as VMs Ubuntu
# para que elas se autentiquem entre si sem senha. Fica salva dentro de
# LAB_DIR, gerada automaticamente se não existir.
CLUSTER_KEY_PATH="$LAB_DIR/cluster_key"

# --- Rede isolada do lab (sem NAT, sem DHCP do libvirt) ---------------
# Só um switch L2 isolado: sem <ip>/<dhcp>. Quem roteia para a internet
# é a VM swfs-router, com uma perna nesta rede e outra na rede "default"
# do KVM (NAT, já existente). Por isso os IPs abaixo são ESTÁTICOS,
# configurados via cloud-init (netplan) — não tem DHCP aqui.
NET_NAME="seaweedfs-lab"
NET_BRIDGE="virbr-swfs"
NET_PREFIX=24
NET_DNS="1.1.1.1 8.8.8.8"

declare -A VM_IP=(
    [swfs-master1]="192.168.100.11"
    [swfs-master2]="192.168.100.12"
    [swfs-master3]="192.168.100.13"
    [swfs-s3front1]="192.168.100.31"
    [swfs-pgsql01]="192.168.100.41"
    [swfs-node01]="192.168.100.51"
    [swfs-node02]="192.168.100.52"
    [swfs-node03]="192.168.100.53"
    [swfs-node04]="192.168.100.54"
    [swfs-node05]="192.168.100.55"
    [swfs-node06]="192.168.100.56"
    [swfs-node07]="192.168.100.57"
)
declare -A VM_MAC=(
    [swfs-master1]="52:54:00:10:00:11"
    [swfs-master2]="52:54:00:10:00:12"
    [swfs-master3]="52:54:00:10:00:13"
    [swfs-s3front1]="52:54:00:10:00:31"
    [swfs-pgsql01]="52:54:00:10:00:41"
    [swfs-node01]="52:54:00:10:00:51"
    [swfs-node02]="52:54:00:10:00:52"
    [swfs-node03]="52:54:00:10:00:53"
    [swfs-node04]="52:54:00:10:00:54"
    [swfs-node05]="52:54:00:10:00:55"
    [swfs-node06]="52:54:00:10:00:56"
    [swfs-node07]="52:54:00:10:00:57"
)

# --- VM roteador (Ubuntu, mesma imagem-base, NAT automatizado) --------
ROUTER_NAME="swfs-router"
ROUTER_RAM_MB=1024
ROUTER_VCPUS=1
ROUTER_DISK_SIZE="10G"

# Perna LAN do roteador (na rede isolada seaweedfs-lab) — é o gateway
# do lab. IP fixo, configurado via cloud-init (assim como as demais VMs).
ROUTER_LAN_IP="192.168.100.1"
ROUTER_LAN_MAC="52:54:00:10:00:01"

# Perna WAN do roteador — usa a rede "default" (NAT) que o KVM já cria.
# IP fixo reservado por MAC nessa rede (necessário para você conseguir
# alcançar o roteador — e, através dele, o lab isolado — via SSH a
# partir do host; veja README > Acesso SSH).
ROUTER_WAN_NETWORK="default"
ROUTER_WAN_MAC="52:54:00:10:00:00"
ROUTER_WAN_IP="192.168.122.150"

# Gateway/DNS que as VMs Ubuntu vão usar (aponta para o roteador)
NET_GATEWAY="$ROUTER_LAN_IP"
